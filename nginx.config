server {
    listen 80;
    server_name coachkirubi.kalkyokya.tech;

    # frontend SPA build output
    root /var/www/coachkirubi/frontend/dist;
    index index.html;

    # Basic hardening
    server_tokens off;
    client_max_body_size 20m;

    # Gunicorn unix socket (project naming convention: /run/gunicorn-<project_name>/gunicorn.sock)
    set $gunicorn_socket unix:/run/gunicorn-coachkirubi/gunicorn.sock;

    # Static assets collected by Django (STATIC_ROOT)
    location /static/ {
        alias /var/www/coachkirubi/backend/staticfiles/;
	access_log off;
	expires 30d;
	add_header Cache-control "public, max-age=2592000, immutable";
    }

    # User-uploaded assets (MEDIA_ROOT)
    location /media/ {
        alias /var/www/coachkirubi/backend/media/;
	access_log off;
	expires 7d;
	add_header Cache-control "public, max-age=604800";
    }

    # Django API endpoints
    location /api/ {
        proxy_pass http://$gunicorn_socket;
	proxy_http_version 1.1;

	proxy_set_header Host $host;
	proxy_set_header X-Real-IP $remote_addr;
	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_set_header X-Forwarded-Host $host;
	proxy_set_header X-Forwarded-Port $server_port;

	proxy_connect_timeout 30s;
	proxy_send_timeout 60s;
	proxy_read_timeout 60s;
    }

    # Django admin stays server-rendered (not handled by SPA fallback)
    location /admin/ {
        proxy_pass http://$gunicorn_socket;
	proxy_http_version 1.1;

	proxy_set_header Host $host;
	proxy_set_header X-Real-IP $remote_addr;
	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_set_header X-Forwarded-Host $host;
	proxy_set_header X-Forwarded-Port $server_port;

	proxy_connect_timeout 30s;
	proxy_send_timeout 60s;
	proxy_read_timeout 60s;
    }

    # Frontend SPA routes
    location / {
	try_files $uri $uri/ /index.html;
    }
}
