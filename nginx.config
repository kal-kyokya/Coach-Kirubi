server {
    listen 80;
    server_name coachkirubi.kalkyokya.tech;

    # React frontend build
    root /var/www/coachkirubi/frontend/dist;
    index index.html;

    # Serve frontend routes
    location / {
        try_files $uri /index.html;
    }

    # Django static files
    location /static/ {
        alias /var/www/coachkirubi/backend/static/;
    }

    # Django media files (if any)
    location /media/ {
        alias /var/www/coachkirubi/backend/media/;
    }

    # Proxy Django (API + admin)
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /admin/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}