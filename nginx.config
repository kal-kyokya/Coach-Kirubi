# --- Force HTTP -> HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name coachkirubi.kalkyokya.tech www.coachkirubi.kalkyokya.tech;
    return 301 https://$host$request_uri;
}

# --- HTTPS server
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name coachkirubi.kalkyokya.tech www.coachkirubi.kalkyokya.tech;

    # --- TLS (Certbot-managed) ---
    ssl_certificate /etc/letsencrypt/live/coachkirubi.kalkyokya.tech/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/coachkirubi.kalkyokya.tech/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # --- Logs (optional per-location logs removed for simplicity) ---
    access_log /var/log/nginx/coachkirubi_access.log;
    error_log /var/log/nginx/coachkirubi_error.log;

    # --- Security headers (basic set) ---
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # --- Performance ---
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 256;

    # --- Upload limits (adjustable if one uploads large files) ---
    client_max_body_size 50m;

    # frontend SPA build output
    root /var/www/coachkirubi/frontend/dist;
    index index.html;

    # Basic hardening
    server_tokens off;

    # Gunicorn unix socket (project naming convention: /run/gunicorn-<project_name>/gunicorn.sock)
    set $gunicorn_socket unix:/run/gunicorn-coachkirubi/gunicorn.sock;

    # Static assets collected by Django (STATIC_ROOT)
    location /static/ {
        alias /home/jpkk/Coach-Kirubi/backend/staticfiles/;
	access_log off;
	expires 30d;
	add_header Cache-control "public, max-age=2592000, immutable";
    }

    # User-uploaded assets (MEDIA_ROOT)
    location /media/ {
        alias /home/jpkk/Coach-Kirubi/backend/media/;
	access_log off;
	expires 7d;
	add_header Cache-control "public, max-age=604800";
    }

    # Django API endpoints
    location /api/ {
        proxy_pass http://$gunicorn_socket;
	proxy_http_version 1.1;

	proxy_set_header Host $host;
	proxy_set_header X-Real-IP $remote_addr;
	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_set_header X-Forwarded-Host $host;
	proxy_set_header X-Forwarded-Port $server_port;

	proxy_connect_timeout 30s;
	proxy_send_timeout 60s;
	proxy_read_timeout 60s;
    }

    # Django admin stays server-rendered (not handled by SPA fallback)
    location /admin/ {
        proxy_pass http://$gunicorn_socket;
	proxy_http_version 1.1;

	proxy_set_header Host $host;
	proxy_set_header X-Real-IP $remote_addr;
	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_set_header X-Forwarded-Host $host;
	proxy_set_header X-Forwarded-Port $server_port;

	proxy_connect_timeout 30s;
	proxy_send_timeout 60s;
	proxy_read_timeout 60s;
    }

    # Frontend SPA routes
    location / {
	try_files $uri $uri/ /index.html;
    }
}
