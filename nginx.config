server {
    listen 80;
    server_name coachkirubi.kalkyokya.tech;

    # React frontend build
    root /var/www/coachkirubi/frontend/dist;
    index index.html;

    # Serve frontend routes
    location / {
        try_files $uri /index.html;
    }

    # Django static files
    location /static/ {
        alias /var/www/coachkirubi/backend/static/;
    }

    # Django media files (if any)
    location /media/ {
        alias /var/www/coachkirubi/backend/media/;
    }

    # --- Proxy ALL API routes to Django via Gunicorn (Unix socket)
    # We keep NO trailing path in proxy_pass, so Nginx forwards the client URI unchanged.
    location /api/ {
        include /etc/nginx/proxy_params;
        proxy_pass http://unix:/run/gunicorn-keruvim/gunicorn.sock;
    }

    # Django admin (excluded from the SPA)
    location /admin/ {
        include /etc/nginx/proxy_params;
        proxy_pass http://unix:/run/gunicorn-keruvim/gunicorn.sock;
    }
}